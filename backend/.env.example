# Server
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
SESSION_JWT_SECRET=replace-with-a-long-random-string

# Google OAuth (Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# Gmail push notifications (Google Cloud Pub/Sub)
# Topic must grant publish rights to gmail-api-push@system.gserviceaccount.com
GOOGLE_PUBSUB_TOPIC=projects/YOUR_PROJECT_ID/topics/gmail-inbox
GOOGLE_PUBSUB_SUBSCRIPTION=projects/YOUR_PROJECT_ID/subscriptions/gmail-inbox-sub
GOOGLE_CLOUD_PROJECT_ID=

# If using a service account for Pub/Sub pull (recommended for local/dev deploys
# instead of a push webhook, which needs a domain-verified HTTPS endpoint)
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# xAI (Grok) — powers the AI assistant's tool-calling/reasoning, via the
# OpenAI-compatible Chat Completions API. Get a key from https://console.x.ai
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.6

# Database — PostgreSQL, used for both local dev and production (see
# README "Quick start" for the fastest way to get a free instance).
# Schema is synced with `npx prisma db push` (no migration files needed —
# see prisma/schema.prisma header for why).
DATABASE_URL="postgresql://user:password@localhost:5432/nebula_mail"
